datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         String
  firstName    String
  lastName     String
  phone        String?
  avatar       String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  patient      Patient?
  doctor       Doctor?
  notifications Notification[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  color       String   @default("#329BFA")
  createdAt   DateTime @default(now())

  doctors     Doctor[]

  @@map("departments")
}

model Doctor {
  id              String           @id @default(uuid())
  userId          String           @unique
  departmentId    String
  specialization  String
  qualification   String
  experienceYears Int              @default(0)
  consultationFee Float
  biography       String?
  roomNumber      String?
  isAvailable     Boolean          @default(true)
  createdAt       DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id])
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labReports      LabReport[]

  @@map("doctors")
}

model Patient {
  id                   String          @id @default(uuid())
  userId               String          @unique
  dateOfBirth          DateTime
  gender               String
  bloodGroup           String?
  address              String?
  emergencyContactName String?
  emergencyContactPhone String?
  allergies            String?
  createdAt            DateTime        @default(now())

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments         Appointment[]
  medicalRecords       MedicalRecord[]
  prescriptions        Prescription[]
  labReports           LabReport[]
  bills                Bill[]

  @@map("patients")
}

model DoctorSchedule {
  id           String   @id @default(uuid())
  doctorId     String
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int      @default(30)
  isActive     Boolean  @default(true)

  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_schedules")
}

model Appointment {
  id                 String         @id @default(uuid())
  appointmentNumber  String         @unique
  patientId          String
  doctorId           String
  appointmentDate    String
  timeSlot           String
  status             String         @default("CONFIRMED")
  reasonForVisit     String
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  patient            Patient        @relation(fields: [patientId], references: [id])
  doctor             Doctor         @relation(fields: [doctorId], references: [id])
  medicalRecord      MedicalRecord?
  bills              Bill[]

  @@index([doctorId, appointmentDate, timeSlot])
  @@map("appointments")
}

model MedicalRecord {
  id                  String        @id @default(uuid())
  appointmentId       String        @unique
  patientId           String
  doctorId            String
  diagnosis           String
  symptoms            String
  physicalExamination String?
  treatmentPlan       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  appointment         Appointment   @relation(fields: [appointmentId], references: [id])
  patient             Patient       @relation(fields: [patientId], references: [id])
  doctor              Doctor        @relation(fields: [doctorId], references: [id])
  prescription        Prescription?

  @@map("medical_records")
}

model Prescription {
  id             String             @id @default(uuid())
  recordId       String             @unique
  patientId      String
  doctorId       String
  prescribedDate DateTime           @default(now())
  notes          String?
  status         String             @default("ACTIVE")

  medicalRecord  MedicalRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  patient        Patient            @relation(fields: [patientId], references: [id])
  doctor         Doctor             @relation(fields: [doctorId], references: [id])
  items          PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model LabReport {
  id          String   @id @default(uuid())
  patientId   String
  doctorId    String?
  testName    String
  category    String
  testDate    DateTime
  status      String   @default("COMPLETED")
  filePath    String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  summary     String?
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id])
  doctor      Doctor?  @relation(fields: [doctorId], references: [id])

  @@map("lab_reports")
}

model Bill {
  id            String     @id @default(uuid())
  billNumber    String     @unique
  patientId     String
  appointmentId String?
  subtotal      Float
  tax           Float
  totalAmount   Float
  paidAmount    Float      @default(0)
  status        String     @default("UNPAID")
  dueDate       DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient       Patient    @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  items         BillItem[]
  payments      Payment[]

  @@map("bills")
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  amount      Float

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_items")
}

model Payment {
  id             String   @id @default(uuid())
  billId         String
  transactionRef String   @unique
  amount         Float
  paymentMethod  String
  paymentDate    DateTime @default(now())
  status         String   @default("SUCCESS")
  notes          String?

  bill           Bill     @relation(fields: [billId], references: [id])

  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model HospitalNotice {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("MAINTENANCE")
  reporter  String?
  priority  String   @default("NORMAL")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("hospital_notices")
}
